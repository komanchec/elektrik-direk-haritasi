{
  "name": "elektrik-direk-haritasi-workspace",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "backend":  "cd packages/backend && npm run dev",
    "frontend": "cd packages/frontend && npm run dev",
    "migrate":  "cd packages/backend && npm run migrate",
    "build":    "cd packages/frontend && npm run build",
    "db:up":    "docker compose up -d postgres",
    "db:down":  "docker compose down",
    "db:logs":  "docker compose logs -f postgres"
  }
}
